{
  "name": "ptc-library-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:svg-assets": "node ./scripts/generate-svg-assets.js",
    "build:apk": "npm exec --yes eas-cli -- build -p android --profile preview --clear-cache",
    "build:preview:android": "npm exec --yes eas-cli -- build -p android --profile preview --clear-cache",
    "build:preview:ios": "npm exec --yes eas-cli -- build -p ios --profile preview",
    "build:android": "npm exec --yes eas-cli -- build -p android --profile production",
    "build:ios": "npm exec --yes eas-cli -- build -p ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "axios": "^1.8.4",
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-print": "~14.1.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "html5-qrcode": "^2.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-svg": "^13.14.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "react-native-svg-transformer": "^1.5.3"
  }
}
